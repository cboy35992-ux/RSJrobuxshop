<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>RSR Admin Support</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<header class="navbar">
  <a class="brand" href="/"><span class="brand-logo">R</span><span><strong>RSR ADMIN</strong><small>Support & Orders</small></span></a>
</header>

<main class="admin-main">
  <section class="panel">
    <span class="small-label">PRIVATE ADMIN ACCESS</span>
    <h1>Admin Order Support <span id="adminUnreadBadge" class="nav-unread hidden">0</span></h1>
    <p class="hint">Enter your admin key and an order number to open the customer conversation.</p>

    <div class="admin-lookup">
      <div class="form-group">
        <label for="adminKey">Admin Private Key</label>
        <input id="adminKey" type="password" placeholder="Example: RSRAdmin2026Private">
      </div>
      <div class="form-group">
        <label for="adminOrderNumber">Order Number</label>
        <input id="adminOrderNumber" type="text" placeholder="RSR-20260802-1234">
      </div>
      <button id="openAdminOrder" class="primary-button" type="button">Open Customer Order</button>
    </div>

    <p id="adminMessage" class="message"></p>

    <div id="adminOrderArea" class="hidden">
      <div class="admin-order-head">
        <div class="order-profile">
          <img id="adminAvatar" alt="Roblox avatar">
          <div>
            <h2 id="adminDisplayName">Customer</h2>
            <p id="adminUsername">@username</p>
            <small id="adminCustomerAccount"></small>
          </div>
        </div>
        <span id="adminStatusBadge" class="selected-badge">Pending</span>
      </div>

      <div id="adminOrderSummary" class="order-summary"></div>

      <div class="decision-panel">
        <button id="approveOrder" class="decision-button approve-button" type="button">✓ Approve Order</button>
        <button id="processingOrder" class="decision-button processing-button" type="button">Mark Processing</button>
        <button id="completeOrder" class="decision-button complete-button" type="button">Mark Completed</button>
        <button id="declineOrder" class="decision-button decline-button" type="button">✕ Decline Order</button>
      </div>

      <div class="receipt-actions">
        <a id="viewReceipt" target="_blank">View Payment Receipt</a>
      </div>

      <h2 class="chat-heading">Chat with Customer</h2>
      <div id="adminChatMessages" class="chat-messages"></div>
      <div class="chat-compose">
        <textarea id="adminChatText" rows="3" placeholder="Reply as RSR Admin…"></textarea>
        <button id="sendAdminChat" type="button">Send Admin Reply</button>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-heading">
      <div><span class="small-label">ORDER MANAGER</span><h2>All Orders</h2><p class="hint">Load all customer orders using the same admin key.</p></div>
      <button id="loadOrders" class="secondary-button" type="button">Load All Orders</button>
    </div>

    <div id="adminControls" class="hidden">
      <div class="admin-marketplace-tools">
        <div class="tool-card">
          <h3>Support Availability</h3>
          <label class="switch-line"><input id="supportOnlineInput" type="checkbox"> Admin support online</label>
          <input id="supportStatusText" type="text" placeholder="Example: Replies within 10 minutes">
          <button id="saveSupportStatus" type="button">Save Support Status</button>
        </div>
        <div class="tool-card">
          <h3>Create Promo Code</h3>
          <input id="promoAdminCode" type="text" placeholder="WELCOME5">
          <input id="promoAdminDiscount" type="number" min="1" max="100" placeholder="Discount percent">
          <input id="promoAdminLimit" type="number" min="1" placeholder="Usage limit (optional)">
          <button id="createPromo" type="button">Create Promo</button>
        </div>
      </div>
      <div class="stats-grid">
        <div class="stat-card"><span>Total Orders</span><strong id="statOrders">0</strong></div>
        <div class="stat-card"><span>Pending</span><strong id="statPending">0</strong></div>
        <div class="stat-card"><span>Approved/Completed</span><strong id="statApproved">0</strong></div>
        <div class="stat-card"><span>Total Sales</span><strong id="statSales">₱0.00</strong></div>
      </div>
      <div class="stock-admin">
        <div class="form-group">
          <label for="instantStockInput">Robux Instant Stock</label>
          <input id="instantStockInput" type="number" min="0" step="1" placeholder="50000">
          <small>Customers see this stock on the Instant card.</small>
        </div>
        <button id="saveStock" type="button">Update Stock</button>
      </div>
    </div>

    <div id="orders" class="admin-orders"></div>
  </section>
</main>

<script src="admin.js"></script>
</body>
</html>