*{box-sizing:border-box;margin:0;padding:0}:root{--bg:#060913;--surface:#101725;--input:#0a101d;--border:rgba(255,255,255,.1);--text:#f8fafc;--muted:#94a3b8;--primary:#8b5cf6;--primary2:#a855f7;--green:#22c55e;--red:#ef4444;--yellow:#facc15}body{font-family:Arial,sans-serif;background:radial-gradient(circle at 10% 10%,rgba(124,58,237,.18),transparent 32%),var(--bg);color:var(--text);min-height:100vh}button,input,textarea{font:inherit}.navbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:14px max(18px,calc((100% - 1020px)/2));background:rgba(6,9,19,.92);border-bottom:1px solid var(--border);backdrop-filter:blur(14px)}.brand{display:flex;gap:10px;align-items:center;color:white;text-decoration:none}.brand-logo{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--primary),var(--primary2));font-weight:900}.brand span:last-child{display:flex;flex-direction:column}.brand small{color:var(--muted)}nav{display:flex;gap:10px;align-items:center}nav a,.nav-button{color:#cbd5e1;background:transparent;border:1px solid var(--border);border-radius:10px;padding:9px 12px;text-decoration:none;cursor:pointer}main{width:min(1020px,calc(100% - 24px));margin:auto;padding:46px 0 80px}.hero{text-align:center;margin-bottom:40px}.hero-badge{display:inline-block;color:#d8b4fe;border:1px solid rgba(168,85,247,.35);background:rgba(124,58,237,.12);padding:7px 13px;border-radius:999px;font-weight:800;font-size:13px}.hero h1{font-size:clamp(38px,7vw,66px);line-height:1.05;margin:15px 0}.hero h1 span{color:#8ea1ff}.hero p,.section-title p,.hint{color:var(--muted);line-height:1.6}.shop-section{display:flex;flex-direction:column;gap:22px}.section-title{display:flex;gap:13px;align-items:center}.step-number{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--primary);font-weight:900}.method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.method-card{color:var(--text);text-align:left;background:rgba(16,23,37,.92);border:1px solid var(--border);padding:20px;border-radius:18px;cursor:pointer;transition:.2s}.method-card:hover{transform:translateY(-3px)}.method-card.active{border-color:#a855f7;background:linear-gradient(145deg,rgba(124,58,237,.24),rgba(16,23,37,.96))}.method-icon{font-size:30px;display:block;margin-bottom:12px}.method-card h3{margin-bottom:8px}.method-card p{color:var(--muted);line-height:1.5;min-height:66px}.method-card strong{color:#d8b4fe}.panel{background:rgba(16,23,37,.92);border:1px solid var(--border);border-radius:20px;padding:25px}.panel-heading{display:flex;justify-content:space-between;gap:15px;margin-bottom:22px}.small-label{color:#a78bfa;font-size:11px;font-weight:900;letter-spacing:1px}.selected-badge{background:rgba(124,58,237,.16);color:#d8b4fe;padding:8px 12px;border-radius:999px;height:max-content}.form-group{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}.form-group label{font-weight:700}.form-group input,.form-group textarea,.modal-card input{width:100%;background:var(--input);color:var(--text);border:1px solid var(--border);border-radius:11px;padding:13px;outline:none}.form-group input:focus,.form-group textarea:focus{border-color:#a855f7}.form-group small{color:var(--muted)}.search-row{display:grid;grid-template-columns:1fr auto;gap:10px}.search-row button{border:0;border-radius:11px;padding:0 16px;background:var(--primary);color:#fff;font-weight:800;cursor:pointer}.roblox-result{display:flex;align-items:center;gap:13px;margin-top:4px;padding:13px;border:1px solid rgba(139,92,246,.55);background:rgba(139,92,246,.08);border-radius:14px}.roblox-result img{width:68px;height:68px;border-radius:50%;background:#1f2937}.roblox-result p{color:#a5b4fc;margin:4px 0}.verified-pill{margin-left:auto;color:#86efac;background:rgba(34,197,94,.12);padding:6px 9px;border-radius:999px;font-size:12px;font-weight:800}.tax-options,.payment-methods{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tax-card,.payment-card{display:flex;gap:11px;align-items:center;padding:15px;border:1px solid var(--border);border-radius:14px;background:var(--input);cursor:pointer}.tax-card.active,.payment-card.active{border-color:#a855f7;background:rgba(124,58,237,.1)}.tax-card span,.payment-card>span:last-child{display:flex;flex-direction:column;gap:4px}.tax-card small,.payment-card small{color:var(--muted)}.gifting-fields,.payment-proof{display:grid;grid-template-columns:repeat(2,1fr);gap:0 15px}.full-width{grid-column:1/-1}.quick-amounts{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px}.quick-amounts button{background:var(--input);color:#cbd5e1;border:1px solid var(--border);border-radius:9px;padding:9px 13px;cursor:pointer}.calculation-box{border:1px solid var(--border);border-radius:15px;overflow:hidden;background:var(--input)}.calculation-box>div{display:flex;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border)}.calculation-box>div:last-child{border-bottom:0}.calculation-box span{color:var(--muted)}.total-row{background:rgba(124,58,237,.12)}.total-row strong{font-size:21px;color:#d8b4fe}.payment-logo{display:grid;place-items:center;width:62px;height:42px;border-radius:9px;font-weight:900}.gcash-logo{background:#1264dd}.gotyme-logo{background:#17dce4;color:#07131a}.qr-panel{display:grid;grid-template-columns:minmax(220px,330px) 1fr;gap:26px;align-items:center;margin:20px 0;padding:20px;background:#f8fafc;color:#111827;border-radius:17px}.qr-wrapper{background:white;border:1px solid #e2e8f0;border-radius:14px;padding:8px}.qr-wrapper img{display:block;width:100%;max-height:460px;object-fit:contain}.qr-panel ol{padding-left:20px;color:#475569;line-height:1.7}.amount-to-pay{display:flex;justify-content:space-between;margin-top:18px;padding:15px;border-radius:12px;background:#ede9fe;color:#5b21b6}.amount-to-pay strong{font-size:22px}.confirm{display:flex;gap:10px;align-items:flex-start;color:#cbd5e1}.primary-button{width:100%;border:0;border-radius:12px;padding:14px;background:linear-gradient(135deg,var(--primary),var(--primary2));color:white;font-weight:900;margin-top:16px;cursor:pointer}.message{margin-top:12px;line-height:1.5}.message.error{color:#fca5a5}.message.success{color:#86efac}.message a{color:#c4b5fd}.floating-help{position:fixed;right:18px;bottom:18px;border:0;border-radius:999px;padding:13px 18px;background:var(--primary);color:white;font-weight:900;box-shadow:0 12px 35px rgba(124,58,237,.4);cursor:pointer}.modal{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.72)}.modal-card{position:relative;width:min(440px,100%);background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:25px}.modal-card p{color:var(--muted);margin:10px 0 15px;line-height:1.5}.close-button{position:absolute;right:13px;top:10px;background:transparent;color:#94a3b8;border:0;font-size:28px;cursor:pointer}.hidden{display:none!important}@media(max-width:760px){.method-grid{grid-template-columns:1fr}.tax-options,.payment-methods,.gifting-fields,.payment-proof,.qr-panel{grid-template-columns:1fr}.method-card p{min-height:auto}.panel{padding:18px}.panel-heading{flex-direction:column}.search-row{grid-template-columns:1fr}.search-row button{padding:12px}.navbar{padding:12px}.navbar nav a{display:none}.calculation-box>div{flex-direction:column;gap:5px}}.status-main,.admin-main{width:min(900px,calc(100% - 24px));margin:auto;padding:45px 0}.status-search,.admin-login{display:grid;grid-template-columns:1fr 1fr auto;gap:9px;margin:18px 0}.status-search input,.admin-login input,.chat-compose textarea{background:var(--input);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:12px}.status-search button,.admin-login button,.chat-compose button,.admin-actions button{border:0;border-radius:9px;padding:10px 13px;background:var(--primary);color:white;font-weight:800;cursor:pointer}.order-profile{display:flex;align-items:center;gap:12px}.order-profile img{width:64px;height:64px;border-radius:50%;background:#1f2937}.order-profile p{color:var(--muted)}.order-summary{margin:18px 0;border:1px solid var(--border);border-radius:13px;overflow:hidden}.order-summary>div{display:flex;justify-content:space-between;gap:15px;padding:12px 14px;border-bottom:1px solid var(--border)}.order-summary>div:last-child{border-bottom:0}.order-summary span{color:var(--muted)}.chat-heading{margin:22px 0 10px}.chat-messages{max-height:360px;overflow:auto;display:flex;flex-direction:column;gap:10px;padding:12px;background:var(--input);border:1px solid var(--border);border-radius:13px}.chat-message{max-width:82%;padding:11px 13px;border-radius:13px}.chat-message>div{display:flex;justify-content:space-between;gap:14px;margin-bottom:5px}.chat-message small{color:var(--muted)}.customer-message{align-self:flex-start;background:#172033}.admin-message{align-self:flex-end;background:rgba(124,58,237,.28)}.chat-compose{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:10px}.admin-orders{display:flex;flex-direction:column;gap:18px}.admin-order{border:1px solid var(--border);background:var(--input);border-radius:16px;padding:17px}.admin-order-head{display:flex;justify-content:space-between;gap:12px}.admin-actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.admin-actions a{color:#c4b5fd;padding:9px;text-decoration:none}@media(max-width:700px){.status-search,.admin-login,.chat-compose{grid-template-columns:1fr}.order-summary>div{flex-direction:column}.admin-order-head{flex-direction:column}}
.method-card{position:relative}
.stock-badge{position:absolute;top:15px;right:15px;padding:6px 9px;border-radius:999px;background:rgba(34,197,94,.14);color:#86efac;font-size:11px;font-weight:800}
.stock-admin{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;margin:18px 0;padding:15px;border:1px solid var(--border);border-radius:14px;background:var(--input)}
.stock-admin .form-group{margin:0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0}
.stat-card{padding:14px;border:1px solid var(--border);border-radius:13px;background:var(--input)}
.stat-card span{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}
.stat-card strong{font-size:21px;color:#d8b4fe}
@media(max-width:700px){.stats-grid{grid-template-columns:repeat(2,1fr)}.stock-admin{grid-template-columns:1fr}}

.auth-body{display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 15% 10%,rgba(124,58,237,.25),transparent 35%),var(--bg)}
.auth-shell{width:min(980px,100%);display:grid;grid-template-columns:1.05fr .95fr;border:1px solid var(--border);border-radius:24px;overflow:hidden;background:rgba(16,23,37,.94);box-shadow:0 28px 90px rgba(0,0,0,.4)}
.auth-brand-panel{padding:50px;background:linear-gradient(145deg,rgba(124,58,237,.32),rgba(9,14,27,.95))}
.large-brand{margin-bottom:45px}.auth-brand-panel h1{font-size:clamp(32px,5vw,52px);line-height:1.08;margin-bottom:18px}.auth-brand-panel>p{color:#cbd5e1;line-height:1.7;font-size:17px}
.auth-features{display:grid;gap:13px;margin-top:32px;color:#d8b4fe;font-weight:700}.auth-card{padding:42px}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--input);border-radius:12px;padding:4px;margin-bottom:30px}
.auth-tabs button{border:0;background:transparent;color:var(--muted);padding:11px;border-radius:9px;font-weight:800;cursor:pointer}.auth-tabs button.active{background:var(--primary);color:white}
.auth-card h2{font-size:28px;margin-bottom:6px}.account-button{display:flex;align-items:center;gap:8px;background:var(--input);border:1px solid var(--border);border-radius:999px;padding:5px 10px 5px 5px;color:white;cursor:pointer}
.account-button>span:first-child{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--primary);font-weight:900}
.account-menu{position:fixed;right:max(16px,calc((100% - 1020px)/2));top:70px;z-index:40;width:240px;padding:14px;background:#111827;border:1px solid var(--border);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.4)}
.account-menu>div{display:flex;flex-direction:column;padding:7px 8px 13px;border-bottom:1px solid var(--border)}.account-menu small{color:var(--muted);margin-top:3px}
.account-menu a,.account-menu button{display:block;width:100%;text-align:left;color:#e2e8f0;background:transparent;border:0;padding:11px 8px;text-decoration:none;cursor:pointer;border-radius:8px}.account-menu a:hover,.account-menu button:hover{background:rgba(124,58,237,.13)}
.transactions-panel{margin-top:24px}.secondary-button{border:1px solid var(--border);background:var(--input);color:#cbd5e1;padding:10px 13px;border-radius:10px;cursor:pointer}
.transactions-list{display:flex;flex-direction:column;gap:9px}.transaction-item{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto;gap:13px;align-items:center;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--input)}
.transaction-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:11px;background:rgba(124,58,237,.14);font-size:20px}.transaction-main,.transaction-amount{display:flex;flex-direction:column;gap:4px}.transaction-main span,.transaction-amount span{color:var(--muted);font-size:12px}
.transaction-amount{text-align:right}.transaction-status{padding:6px 9px;border-radius:999px;font-size:11px;font-weight:900;background:rgba(250,204,21,.12);color:#fde68a}.transaction-status.approved,.transaction-status.completed{background:rgba(34,197,94,.13);color:#86efac}.transaction-status.cancelled{background:rgba(239,68,68,.13);color:#fca5a5}.transaction-status.processing{background:rgba(59,130,246,.13);color:#93c5fd}
.transaction-link{color:#d8b4fe;text-decoration:none;font-weight:800}.empty-state{text-align:center;padding:34px;color:var(--muted)}.empty-state span{font-size:34px}.empty-state h3{color:white;margin:10px 0 5px}
@media(max-width:760px){.auth-shell{grid-template-columns:1fr}.auth-brand-panel{display:none}.auth-card{padding:26px}.account-button #accountName{display:none}.transaction-item{grid-template-columns:auto 1fr auto}.transaction-status{grid-column:2}.transaction-link{grid-column:3;grid-row:2}.transaction-amount{grid-column:3;grid-row:1}}

.admin-lookup{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end;margin:20px 0}
.admin-lookup .form-group{margin:0}.admin-lookup .primary-button{margin:0;height:48px}
.decision-panel{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:16px 0}
.decision-button{border:0;border-radius:10px;padding:12px 9px;color:white;font-weight:900;cursor:pointer}
.approve-button{background:#15803d}.processing-button{background:#1d4ed8}.complete-button{background:#6d28d9}.decline-button{background:#b91c1c}
.receipt-actions{margin-bottom:15px}.receipt-actions a{display:inline-block;color:#d8b4fe;text-decoration:none;border:1px solid rgba(168,85,247,.35);padding:9px 12px;border-radius:9px}
.token-help{color:#94a3b8;font-size:12px;margin-top:-8px;margin-bottom:15px}
.compact-admin-order{display:grid;gap:11px}.compact-order-meta{display:flex;justify-content:space-between;color:#cbd5e1}
@media(max-width:800px){.admin-lookup{grid-template-columns:1fr}.decision-panel{grid-template-columns:repeat(2,1fr)}}

.nav-unread,.unread-pill{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:#ef4444;color:white;font-size:11px;font-weight:900}
.dashboard-main{width:min(1050px,calc(100% - 24px));margin:auto;padding:42px 0}.dashboard-welcome{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px}.notification-card{padding:17px 22px;border:1px solid rgba(168,85,247,.4);background:rgba(124,58,237,.14);border-radius:16px}.notification-card span{display:block;color:#c4b5fd;font-size:12px}.notification-card strong{font-size:34px}
.dashboard-orders{display:flex;flex-direction:column;gap:10px}.dashboard-order{display:grid;grid-template-columns:minmax(0,1fr) auto auto auto auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--input)}.dashboard-order>div{display:flex;flex-direction:column;gap:4px}.dashboard-order span{color:var(--muted);font-size:12px}.dashboard-order a{color:#d8b4fe;text-decoration:none;font-weight:800}
.review-form{display:grid;grid-template-columns:1fr 180px;gap:10px}.review-form textarea,.review-form select{background:var(--input);color:var(--text);border:1px solid var(--border);border-radius:10px;padding:12px}.review-form textarea,.review-form button{grid-column:1/-1}
.public-timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:18px}.public-timeline div{text-align:center;padding:14px 7px;border:1px solid var(--border);border-radius:12px;background:var(--input)}.public-timeline b{display:grid;place-items:center;width:28px;height:28px;margin:0 auto 8px;border-radius:50%;background:var(--primary)}
.reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.review-card{padding:16px;border:1px solid var(--border);border-radius:14px;background:var(--input)}.review-card>div{display:flex;justify-content:space-between;color:#facc15}.review-card span,.review-card small{color:var(--muted);font-size:11px}.review-card p{margin:13px 0;line-height:1.5}.rating-summary{color:#facc15;font-size:19px;font-weight:900}
.faq-panel details{border-bottom:1px solid var(--border);padding:14px 0}.faq-panel summary{font-weight:800;cursor:pointer}.faq-panel details p{color:var(--muted);line-height:1.6;margin-top:10px}
.order-timeline{display:flex;overflow-x:auto;gap:8px;margin:18px 0}.order-timeline>div{min-width:135px;display:flex;align-items:center;gap:8px;padding:11px;border:1px solid var(--border);border-radius:11px;color:var(--muted)}.order-timeline span{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#273244}.order-timeline .done{color:white;border-color:rgba(34,197,94,.45)}.order-timeline .done span{background:#16a34a}.order-timeline .danger-stage{border-color:#ef4444;color:#fca5a5}.reservation-notice{padding:12px;border-radius:10px;background:rgba(250,204,21,.1);color:#fde68a;margin-bottom:15px}
.password-row{display:grid;grid-template-columns:1fr auto}.password-row button{border:1px solid var(--border);background:var(--input);color:#cbd5e1;padding:0 12px;border-radius:0 10px 10px 0}.password-row input{border-radius:10px 0 0 10px!important}.link-button{width:100%;border:0;background:transparent;color:#c4b5fd;margin-top:12px;cursor:pointer}.single-auth{grid-template-columns:1fr;max-width:520px}
@media(max-width:800px){.dashboard-welcome{align-items:flex-start}.customer-stats{grid-template-columns:repeat(2,1fr)}.dashboard-order{grid-template-columns:1fr auto}.dashboard-order .transaction-status,.dashboard-order .unread-pill{grid-column:1}.reviews-grid{grid-template-columns:1fr}.public-timeline{grid-template-columns:1fr}.review-form{grid-template-columns:1fr}}

:root[data-theme="light"]{--bg:#eef2ff;--surface:#ffffff;--input:#f8fafc;--border:rgba(15,23,42,.12);--text:#111827;--muted:#64748b}
:root[data-theme="light"] body{background:radial-gradient(circle at 10% 10%,rgba(124,58,237,.12),transparent 32%),var(--bg)}
.support-indicator{font-size:12px;font-weight:900;padding:7px 10px;border-radius:999px}.support-indicator.online{color:#86efac;background:rgba(34,197,94,.13)}.support-indicator.offline{color:#fca5a5;background:rgba(239,68,68,.12)}
.promo-box{padding:15px;border:1px dashed rgba(168,85,247,.45);border-radius:13px;margin-bottom:16px;background:rgba(124,58,237,.06)}.promo-box .form-group{margin:0}.promo-box small.success{color:#86efac}.promo-box small.error{color:#fca5a5}
.marketplace-features{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.marketplace-features article{padding:18px;border:1px solid var(--border);border-radius:16px;background:rgba(16,23,37,.88)}.marketplace-features span{font-size:28px}.marketplace-features h3{margin:10px 0 6px}.marketplace-features p{color:var(--muted);line-height:1.5;font-size:13px}
.dashboard-banner{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;margin-bottom:18px;border-radius:16px;background:linear-gradient(135deg,rgba(124,58,237,.35),rgba(59,130,246,.18));border:1px solid rgba(168,85,247,.4)}.dashboard-banner div{display:flex;flex-direction:column;gap:5px}.dashboard-banner span{color:#cbd5e1}.dashboard-banner a{color:white;text-decoration:none;background:var(--primary);padding:10px 13px;border-radius:10px;font-weight:800}
.admin-marketplace-tools{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}.tool-card{display:grid;gap:10px;padding:15px;border:1px solid var(--border);border-radius:14px;background:var(--input)}.tool-card input{background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:9px;padding:11px}.tool-card button{border:0;border-radius:9px;padding:11px;background:var(--primary);color:white;font-weight:800;cursor:pointer}.switch-line{display:flex;gap:8px;align-items:center;color:var(--muted)}
@media(max-width:800px){.marketplace-features{grid-template-columns:1fr 1fr}.admin-marketplace-tools{grid-template-columns:1fr}.support-indicator{display:none}}@media(max-width:520px){.marketplace-features{grid-template-columns:1fr}.dashboard-banner{flex-direction:column;align-items:flex-start;gap:12px}}
